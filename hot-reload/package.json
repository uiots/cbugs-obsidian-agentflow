{
	"name": "cbugs-hot-reload",
	"version": "0.1.0",
	"description": "Automatically reload plugins during development when files change",
	"main": "main.js",
	"author": "cBugs",
	"license": "MIT",
	"packageManager": "pnpm@8.0.0",
	"keywords": ["obsidian", "plugin", "cbugs", "hot-reload", "development"],
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}